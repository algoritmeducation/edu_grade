# EduGrade 360 Environment Variables
PORT=3000
NODE_ENV=production

# MongoDB Connection (Optional: e.g. MongoDB Atlas connection string)
# If left empty, EduGrade 360 will automatically use local persistent JSON storage (data/db.json)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/edugrade360?retryWrites=true&w=majority
